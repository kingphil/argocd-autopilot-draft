apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: devel-app
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io/foreground
spec:
  destination:
    namespace: development
    server: https://kubernetes.default.svc
  project: development
  source:
    helm:
      ignoreMissingValueFiles: false
      valueFiles:
        - values.yaml
        - /clusters/development/APPNAME/values.yaml
    path: charts/APPNAME/
    repoURL: https://github.com/kingphil/argocd-autopilot-draft.git
    targetRevision: development
  syncPolicy:
    automated:
      allowEmpty: true
      prune: true
      selfHeal: true
    managedNamespaceMetadata:
      ## so the deletion of the App also removes the namespace it creates
      ## https://github.com/argoproj/argo-cd/issues/7875
      labels:
        argocd.argoproj.io/instance: devel-app
    syncOptions:
      ## refers to spec.destination.namespace
      - CreateNamespace=true
